# ============================================================
# VideoNest 全局 .gitignore
# 参考 GitHub 官方 Java / Maven / Node / JetBrains / OS 模板
# ============================================================

# ---------- Java / Maven ----------
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.war
*.ear
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# 本地 Maven 仓库（误提交到仓库根目录的 .m2，必须排除）
.m2/

# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# 根目录误生成的 npm 锁文件（本项目前端代码在 frontend/ 下）
/package.json
/package-lock.json
/yarn.lock
/pnpm-lock.yaml

# ---------- IDE：IntelliJ IDEA ----------
.idea/
*.iml
*.iws
*.ipr
out/

# ---------- IDE：VS Code ----------
# 注意：frontend/.vscode/extensions.json 属于团队推荐插件配置，
# 行业惯例是保留并入库；这里只忽略可能含个人路径的 settings。
.vscode/settings.json
.vscode/launch.json

# ---------- IDE：Eclipse ----------
.apt_generated/
.classpath
.factorypath
.project
.settings
.springBeans
.sts-cache

# ---------- 操作系统杂项 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- 日志 ----------
logs/
*.log

# ---------- 环境变量与本地配置 ----------
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
application-local.properties

# ---------- 运行时数据 / 持久化卷 ----------
# Redis
deploy/redis/redis-data/
# MySQL（如挂载本地数据卷）
deploy/mysql/mysql-data/
# RabbitMQ
deploy/rabbitmq/rabbitmq-data/
# MinIO
deploy/minio/minio-data/
minio-data/

# ---------- 临时文件与备份 ----------
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~
# 迁移前数据库备份（本地操作产物，不入库）
.migration-backups/
# 部署打包产物
*.tar.gz
*.zip
# 本地调试截图
shard_debug*.png

# ---------- 压测产物 ----------
benchmark/results/
*.jtl
